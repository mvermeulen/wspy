#!/usr/bin/env python3
"""
wspy-publish -- WordPress + report-root publishing (INVESTIGATION.md's 4.3
Tier 3, "Static-site publishing pipeline" item, sub-steps 2-3: dedicated
service-account auth and a minimal REST client to prove connectivity).

Two publish targets, matching doc/REPORT_HIERARCHY.md's own framing of the
report root as a rendered/exported view fed by wspy-store, not a second
data copy:

  - A WordPress site (web/wp_client.py, stdlib urllib, Application
    Password auth) -- doc/REPORT_HIERARCHY.md's 4 levels map onto nested
    WP Pages, one per level, identified by (slug, parent).
  - A local clone of the report-root git repo (doc/REPORT_HIERARCHY.md's
    WSPY_REPORT_ROOT convention) -- plain `git`, shelled out via
    subprocess. Commits are always local only; this tool never pushes on
    its own, since a push is a shared/visible action that deserves an
    explicit human decision every time, not automation.

This script currently has four subcommands:

  configure        interactive credential setup (getpass -- the
                    Application Password never touches argv/shell
                    history/scrollback)
  test-connection   proves both connections end to end without building
                    the real rendering pipeline: WP whoami() + capability
                    report, a lookup-only pass over the two hand-created
                    suite stub pages, one throwaway draft test page, and
                    a clone-or-verify + one local commit against the
                    report-root repo
  publish-page      the draft-first publish flow (4.3 Tier 3 item 2,
                    sub-step 5): create-or-find a page as a draft, verify
                    it (id/link present), optionally set its content,
                    then only flip it to status=publish in a separate,
                    explicit follow-up call (--publish) -- so a pipeline
                    that dies mid-run leaves an inspectable draft instead
                    of a half-written live page. Single-page primitive
                    only: no hierarchy walk (find_or_create_page_path
                    already does that) and no smart merge against a
                    human's prior edits to an existing page -- that's
                    sub-step 4's still-open design question, not solved
                    here.
  upload-media      the media upload endpoint (4.3 Tier 3 item 2,
                    sub-step 6): POST a file's raw bytes to
                    /wp/v2/media, needed before a report page can embed
                    the topdown/AMD-metrics charts or process-tree
                    diagrams the hand-curated /perf/workloads pages
                    already have. Unlike pages, WordPress attachments
                    have no draft state -- the upload itself is the only
                    step, always visible in the media library once it
                    succeeds (referencing it from a still-draft page
                    keeps the *page* unpublished, per publish-page's own
                    draft-first flow).

publish-page also has a --from-rundir mode (sub-step 7: reuse
web/server.py's render_export_wordpress() as the content payload rather
than building block markup a second way): reads a run directory's
curation.json via the same _export_data()/render_export_wordpress()
the web UI's own export tab uses, pre-uploads every depth="full" image
block via upload-media's upload_media() (sub-step 6), and threads the
resulting WordPress media URLs into the generated content in place of
this server's own /files/... URLs -- see export_block_content()'s
image_url parameter in web/server.py. Non-image "full file" reference
links (summary/excerpt text/CSV blocks) still point at --base-url, since
those files aren't uploaded anywhere; pass a real reachable URL or expect
relative/dead links in the published content.

The --from-rundir rendering pipeline (render_wordpress_content_for_rundir())
and the find-or-create-and-optionally-publish orchestration
(wp_client.publish_page_content()) both live in web/server.py and
web/wp_client.py respectively, not here -- this script is a thin CLI
wrapper over them, shared with web/server.py's own "Publish to WordPress"
button on the Export tab (sub-step 8), so the CLI and the web UI can
never drift into different publish behavior for the same operation.

publish-path        create/update a page nested at a full
                     doc/REPORT_HIERARCHY.md path (INVESTIGATION.md Tier 3
                     item 6): publish-page's own --slug path only ever
                     operates at one flat (slug, parent) level (a human
                     resolves the parent id themselves), and
                     find_or_create_page_path() walks a hierarchy but has
                     no content parameter -- neither alone can create a
                     content-bearing page nested under a parent that may
                     itself need auto-creating. wp_client.publish_page_at_path()
                     closes that gap; this subcommand is its thin CLI
                     wrapper, matching publish-page's own draft-first
                     default.
"""
import argparse
import getpass
import json
import os
import stat
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(SCRIPT_DIR, "web"))
import wp_client  # noqa: E402
from wp_client import CONFIG_PATH, load_config  # noqa: E402 -- canonical definitions, shared with
                                                 # web/server.py's own "Publish to WordPress" button
import server as web_export  # noqa: E402 -- only its render_wordpress_content_for_rundir() is used
                              # here; importing it never starts the HTTP server (guarded by
                              # server.py's own __main__ check)
from report_root import (  # noqa: E402 -- shared with wspy-testpoint's run role-assignment
    DEFAULT_REPORT_ROOT, DEFAULT_REPORT_ROOT_REMOTE, ensure_report_root, run_git)

TEST_PAGE_SLUG = "wspy-publish-connectivity-test"


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    fd = os.open(CONFIG_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    os.chmod(CONFIG_PATH, stat.S_IRUSR | stat.S_IWUSR)


def cmd_configure(args):
    print("wspy-publish configure -- writes %s (mode 600)." % CONFIG_PATH, file=sys.stderr)
    existing = load_config() or {}
    wp_existing = existing.get("wordpress", {})

    site_url = input("WordPress site URL [%s]: " % (
        wp_existing.get("site_url") or "https://www.mvermeulen.org/workload")).strip()
    site_url = site_url or wp_existing.get("site_url") or "https://www.mvermeulen.org/workload"

    username = input("WordPress username [%s]: " % (wp_existing.get("username") or "wspy")).strip()
    username = username or wp_existing.get("username") or "wspy"

    app_password = getpass.getpass("WordPress Application Password (input hidden): ").strip()
    if not app_password:
        if wp_existing.get("app_password"):
            app_password = wp_existing["app_password"]
            print("  (keeping existing stored Application Password)", file=sys.stderr)
        else:
            print("wspy-publish: no Application Password entered, aborting", file=sys.stderr)
            return 1

    report_root = input("Report-root git clone path [%s]: " % (
        existing.get("report_root") or DEFAULT_REPORT_ROOT)).strip()
    report_root = report_root or existing.get("report_root") or DEFAULT_REPORT_ROOT

    cfg = {
        "wordpress": {"site_url": site_url, "username": username, "app_password": app_password},
        "report_root": report_root,
    }
    save_config(cfg)
    print("wspy-publish: wrote %s" % CONFIG_PATH, file=sys.stderr)
    return 0


ROOT_README_CONTENT = """# workload

Curated wspy performance reports, one directory per
`<suite>/<test>/<test-point>/<machine>/`. See wspy's own
`doc/REPORT_HIERARCHY.md` (https://github.com/mvermeulen/wspy) for the full
directory convention this tree follows.

This root README was created by `wspy-publish test-connection` to prove
write access to this repository; real per-level content is written by
later wspy-publish pipeline work.
"""


def commit_root_readme(report_root):
    """Writes a root README.md if one doesn't already exist, and commits
    it locally (never pushes). Returns (made_commit, message)."""
    readme_path = os.path.join(report_root, "README.md")
    if os.path.isfile(readme_path):
        return False, "%s already has a README.md -- leaving it alone" % report_root

    rc, out, err = run_git(["status", "--porcelain"], cwd=report_root)
    if rc != 0:
        return False, "git status failed in %s: %s" % (report_root, err)
    if out:
        return False, ("%s has uncommitted changes already -- refusing to add a commit on top "
                        "of unknown state:\n%s" % (report_root, out))

    with open(readme_path, "w") as f:
        f.write(ROOT_README_CONTENT)
    run_git(["add", "README.md"], cwd=report_root)
    rc, out, err = run_git(
        ["commit", "-m", "Add report-root README (wspy-publish test-connection)"],
        cwd=report_root)
    if rc != 0:
        return False, "git commit failed in %s: %s" % (report_root, err)
    rc, sha, err = run_git(["rev-parse", "--short", "HEAD"], cwd=report_root)
    return True, "committed README.md as %s (local only -- not pushed)" % sha


def cmd_test_connection(args):
    cfg = load_config()
    if not cfg:
        print("wspy-publish: no config at %s -- run `wspy-publish configure` first" % CONFIG_PATH,
              file=sys.stderr)
        return 1
    wp = cfg["wordpress"]
    site_url, username, app_password = wp["site_url"], wp["username"], wp["app_password"]
    report_root = cfg.get("report_root") or DEFAULT_REPORT_ROOT

    ok = True

    print("== WordPress: %s ==" % site_url)
    try:
        user = wp_client.whoami(site_url, username, app_password)
    except wp_client.WPError as e:
        print("  auth FAILED (status=%s code=%s): %s" % (e.status, e.code, e), file=sys.stderr)
        ok = False
    else:
        print("  auth OK as %r (id=%s)" % (user.get("name"), user.get("id")))
        missing = wp_client.missing_capabilities(user)
        if missing:
            print("  MISSING capabilities: %s -- page create/publish below may fail" % ", ".join(missing))
            ok = False
        else:
            print("  capabilities OK: %s" % ", ".join(wp_client.REQUIRED_PAGE_CAPABILITIES))

        for slug in ("cpu2026", "phoronix"):
            try:
                page = wp_client.find_page(site_url, username, app_password, slug, 0)
            except wp_client.WPError as e:
                print("  lookup %r FAILED: %s" % (slug, e), file=sys.stderr)
                ok = False
                continue
            if page:
                print("  found existing page %r (id=%s, %s)" % (slug, page["id"], page.get("link")))
            else:
                print("  no existing page %r found at top level (unexpected)" % slug)

        try:
            existing_test_page = wp_client.find_page(site_url, username, app_password,
                                                       TEST_PAGE_SLUG, 0)
            if existing_test_page:
                page = existing_test_page
                print("  reusing existing draft test page (id=%s)" % page["id"])
            else:
                page = wp_client.create_page(
                    site_url, username, app_password, TEST_PAGE_SLUG,
                    "wspy-publish connectivity test -- safe to delete",
                    parent=0,
                    content="<p>Created by wspy-publish test-connection. Safe to delete.</p>",
                    status="draft")
                print("  created draft test page (id=%s) -- edit: %s/wp-admin/post.php?post=%s&action=edit"
                      % (page["id"], site_url.rstrip("/"), page["id"]))
        except wp_client.WPError as e:
            print("  draft test page create FAILED (status=%s code=%s): %s" % (e.status, e.code, e),
                  file=sys.stderr)
            ok = False

    print("== Report root: %s ==" % report_root)
    root_ok, msg = ensure_report_root(report_root, DEFAULT_REPORT_ROOT_REMOTE)
    print("  %s" % msg)
    if not root_ok:
        ok = False
    else:
        made_commit, msg = commit_root_readme(report_root)
        print("  %s" % msg)

    print()
    print("wspy-publish test-connection: %s" % ("OK" if ok else "FAILED (see above)"))
    return 0 if ok else 1


def _render_content_from_rundir(site_url, username, app_password, rundir, title, base_url):
    """CLI wrapper over web/server.py's render_wordpress_content_for_rundir()
    (shared with the web UI's own "Publish to WordPress" button) --
    prints its upload_log as it goes, matching this command's own
    stderr-progress style. Returns (content, ok) -- ok=False means an
    error was already printed and the caller should abort without
    publishing anything."""
    content, upload_log, ok = web_export.render_wordpress_content_for_rundir(
        rundir, title, base_url, site_url, username, app_password)
    if not ok:
        print("wspy-publish: no curated content in %s (curate it first via the web studio)" % rundir,
              file=sys.stderr)
        return None, False
    for filename, url, error in upload_log:
        if url:
            print("  uploaded %s -> %s" % (filename, url))
        else:
            print("wspy-publish: uploading %s FAILED: %s -- this image will fall back to --base-url "
                  "instead" % (filename, error), file=sys.stderr)
    return content, True


def cmd_publish_page(args):
    cfg = load_config()
    if not cfg:
        print("wspy-publish: no config at %s -- run `wspy-publish configure` first" % CONFIG_PATH,
              file=sys.stderr)
        return 1
    wp = cfg["wordpress"]
    site_url, username, app_password = wp["site_url"], wp["username"], wp["app_password"]

    if bool(args.page_id) == bool(args.slug):
        print("wspy-publish: give exactly one of --page-id or --slug", file=sys.stderr)
        return 1
    if sum(bool(x) for x in (args.content, args.content_file, args.from_rundir)) > 1:
        print("wspy-publish: use only one of --content, --content-file, --from-rundir", file=sys.stderr)
        return 1
    if args.from_rundir and not args.title:
        print("wspy-publish: --title is required with --from-rundir (used as both the page title "
              "and the content's own heading)", file=sys.stderr)
        return 1

    content = args.content
    if args.content_file:
        with open(args.content_file) as f:
            content = f.read()
    elif args.from_rundir:
        content, ok = _render_content_from_rundir(site_url, username, app_password, args.from_rundir,
                                                    args.title, args.base_url)
        if not ok:
            return 1

    try:
        if args.page_id:
            fields = {}
            if content is not None:
                fields["content"] = content
            if args.title:
                fields["title"] = args.title
            page = wp_client.update_page(site_url, username, app_password, args.page_id, **fields) \
                if fields else wp_client.get_page(site_url, username, app_password, args.page_id)
        else:
            page = wp_client.find_page(site_url, username, app_password, args.slug, args.parent_id)
            if page is None:
                if not args.title:
                    print("wspy-publish: --title is required to create a new page (no existing page "
                          "found for slug=%r parent=%s)" % (args.slug, args.parent_id), file=sys.stderr)
                    return 1
                page = wp_client.create_page(site_url, username, app_password, args.slug, args.title,
                                              args.parent_id, content=content or "", status="draft")
                print("  created draft page %r (id=%s)" % (args.slug, page["id"]))
            else:
                print("  found existing page %r (id=%s, status=%s)"
                      % (args.slug, page["id"], page.get("status")))
                fields = {}
                if content is not None:
                    fields["content"] = content
                if args.title:
                    fields["title"] = args.title
                if fields:
                    page = wp_client.update_page(site_url, username, app_password, page["id"], **fields)
                    print("  updated %s" % " and ".join(fields.keys()))
    except wp_client.WPError as e:
        print("wspy-publish: page create/update FAILED (status=%s code=%s): %s" % (e.status, e.code, e),
              file=sys.stderr)
        return 1

    if not page.get("id") or not page.get("link"):
        print("wspy-publish: response missing id/link -- treating as a verification failure: %r" % page,
              file=sys.stderr)
        return 1

    print("  page id=%s status=%s link=%s" % (page["id"], page.get("status"), page.get("link")))

    if not args.publish:
        print("  left as %s -- rerun with --page-id %s --publish to make it live"
              % (page.get("status"), page["id"]))
        return 0

    try:
        page = wp_client.publish_page(site_url, username, app_password, page["id"])
    except wp_client.WPError as e:
        print("wspy-publish: publish FAILED (status=%s code=%s) -- page %s is still a draft, safe to "
              "retry with --page-id %s --publish" % (e.status, e.code, page["id"], page["id"]),
              file=sys.stderr)
        return 1
    print("  published: id=%s status=%s link=%s" % (page["id"], page.get("status"), page.get("link")))
    return 0


def cmd_publish_path(args):
    cfg = load_config()
    if not cfg:
        print("wspy-publish: no config at %s -- run `wspy-publish configure` first" % CONFIG_PATH,
              file=sys.stderr)
        return 1
    wp = cfg["wordpress"]
    site_url, username, app_password = wp["site_url"], wp["username"], wp["app_password"]

    if not args.level:
        print("wspy-publish: at least one --level SLUG TITLE is required", file=sys.stderr)
        return 1
    if args.content and args.content_file:
        print("wspy-publish: use only one of --content, --content-file", file=sys.stderr)
        return 1

    content = args.content
    if args.content_file:
        with open(args.content_file) as f:
            content = f.read()
    levels = [(slug, title) for slug, title in args.level]

    try:
        page, created = wp_client.publish_page_at_path(
            site_url, username, app_password, levels, content or "", do_publish=args.publish)
    except wp_client.WPError as e:
        print("wspy-publish: page create/update FAILED (status=%s code=%s): %s" % (e.status, e.code, e),
              file=sys.stderr)
        return 1

    if not page.get("id") or not page.get("link"):
        print("wspy-publish: response missing id/link -- treating as a verification failure: %r" % page,
              file=sys.stderr)
        return 1

    leaf_slug = levels[-1][0]
    print("  %s leaf page %r (id=%s, status=%s) link=%s"
          % ("created" if created else "found/updated", leaf_slug, page["id"], page.get("status"),
             page["link"]))
    if not args.publish:
        print("  left as %s -- rerun with the same --level path plus --publish to make it live"
              % page.get("status"))
    return 0


def cmd_upload_media(args):
    cfg = load_config()
    if not cfg:
        print("wspy-publish: no config at %s -- run `wspy-publish configure` first" % CONFIG_PATH,
              file=sys.stderr)
        return 1
    wp = cfg["wordpress"]
    site_url, username, app_password = wp["site_url"], wp["username"], wp["app_password"]

    if not os.path.isfile(args.file):
        print("wspy-publish: no such file: %s" % args.file, file=sys.stderr)
        return 1

    try:
        media = wp_client.upload_media(site_url, username, app_password, args.file,
                                        mime_type=args.mime_type)
    except wp_client.WPError as e:
        print("wspy-publish: upload FAILED (status=%s code=%s): %s" % (e.status, e.code, e),
              file=sys.stderr)
        return 1

    if not media.get("id") or not media.get("source_url"):
        print("wspy-publish: response missing id/source_url -- treating as a verification failure: %r"
              % media, file=sys.stderr)
        return 1
    print("  uploaded id=%s source_url=%s" % (media["id"], media["source_url"]))

    meta_fields = {}
    if args.alt_text:
        meta_fields["alt_text"] = args.alt_text
    if args.title:
        meta_fields["title"] = args.title
    if args.caption:
        meta_fields["caption"] = args.caption
    if meta_fields:
        try:
            wp_client.update_media(site_url, username, app_password, media["id"], **meta_fields)
        except wp_client.WPError as e:
            print("wspy-publish: setting %s FAILED (status=%s code=%s): %s"
                  % (", ".join(meta_fields), e.status, e.code, e), file=sys.stderr)
            return 1
        print("  set %s" % ", ".join(meta_fields))

    if args.set_featured_on:
        try:
            wp_client.update_page(site_url, username, app_password, args.set_featured_on,
                                   featured_media=media["id"])
        except wp_client.WPError as e:
            print("wspy-publish: setting featured_media on page %s FAILED (status=%s code=%s): %s"
                  % (args.set_featured_on, e.status, e.code, e), file=sys.stderr)
            return 1
        print("  set as featured_media on page %s" % args.set_featured_on)

    return 0


def main():
    ap = argparse.ArgumentParser(
        description="Publish wspy reports to WordPress and/or the report-root git repo "
                    "(INVESTIGATION.md 4.3 Tier 3).")
    sub = ap.add_subparsers(dest="command", required=True)

    sub.add_parser("configure", help="interactively write %s" % CONFIG_PATH)
    sub.add_parser("test-connection",
                    help="prove WP auth + report-root git access without building real content")

    pub = sub.add_parser("publish-page",
                          help="create/update one WP page as a draft, then optionally publish it")
    pub.add_argument("--page-id", type=int, help="operate on an existing page by id")
    pub.add_argument("--slug", help="page slug to find or create (with --parent-id)")
    pub.add_argument("--parent-id", type=int, default=0,
                      help="parent page id for --slug lookup/create (default: 0, top-level)")
    pub.add_argument("--title", help="page title (required when --slug matches no existing page)")
    pub.add_argument("--content", help="page content (HTML / Gutenberg block markup)")
    pub.add_argument("--content-file", help="read page content from this file instead of --content")
    pub.add_argument("--from-rundir", metavar="DIR",
                      help="generate content from this run directory's curated blocks (curation.json) "
                           "via web/server.py's own render_export_wordpress(), instead of --content; "
                           "pre-uploads depth=full image blocks to the WP media library")
    pub.add_argument("--base-url",
                      help="base URL for non-image 'full file' reference links in --from-rundir content "
                           "(e.g. a running wspy web launcher's address); images are always uploaded to "
                           "WordPress directly and don't need this")
    pub.add_argument("--publish", action="store_true",
                      help="flip the page to status=publish after creating/updating it "
                           "(default: leave it as a draft)")

    pub_path = sub.add_parser("publish-path",
                               help="create/update a page nested at a full hierarchy path, creating "
                                    "any missing parent pages as empty stubs along the way")
    pub_path.add_argument("--level", action="append", nargs=2, metavar=("SLUG", "TITLE"),
                           help="one hierarchy level as SLUG TITLE, given top-down, repeatable "
                                "(e.g. --level cpu2026 cpu2026 --level 706.stockfish_r 706.stockfish_r); "
                                "the last one given is the leaf page that receives content")
    pub_path.add_argument("--content", help="leaf page content (HTML / Gutenberg block markup)")
    pub_path.add_argument("--content-file",
                           help="read leaf page content from this file instead of --content")
    pub_path.add_argument("--publish", action="store_true",
                           help="flip the leaf page to status=publish after creating/updating it "
                                "(default: leave it as a draft)")

    media = sub.add_parser("upload-media",
                            help="upload a file to the WordPress media library")
    media.add_argument("--file", required=True, help="path to the image/file to upload")
    media.add_argument("--mime-type", help="override the guessed MIME type")
    media.add_argument("--alt-text", help="set the attachment's alt text")
    media.add_argument("--title", help="set the attachment's title")
    media.add_argument("--caption", help="set the attachment's caption")
    media.add_argument("--set-featured-on", type=int, metavar="PAGE_ID",
                        help="set the uploaded attachment as this page id's featured_media")

    args = ap.parse_args()
    if args.command == "configure":
        return cmd_configure(args)
    if args.command == "test-connection":
        return cmd_test_connection(args)
    if args.command == "publish-page":
        return cmd_publish_page(args)
    if args.command == "publish-path":
        return cmd_publish_path(args)
    if args.command == "upload-media":
        return cmd_upload_media(args)
    ap.error("unknown command")


if __name__ == "__main__":
    sys.exit(main())

def resolve_report_root(args):
    if args.report_root:
        return args.report_root
    cfg = load_config()
    if cfg and cfg.get("report_root"):
        return cfg["report_root"]
    return report_root.DEFAULT_REPORT_ROOT


def resolve_test_point_paths(args):
    """Returns (report_root_path, test, test_point, runs_json_path) -- the resolution both
    select-runs and aggregate need to find one test point's persisted runs.json, factored out so
    the two subcommands can't drift into slightly different path-construction logic for the same
    file. Passes resolve_dest_roots(args)'s merged {suite: dest_root} dict through to
    resolve_test_identity() -- omitting a suite from it (as this call did for cpu2026 until PR #193/
    #196) silently falls through to the generic test=benchmark,test_point="default" fallback for every
    identity in that suite, since that fallback is resolve_test_identity()'s documented behavior for a
    suite with no dest_root given at all, not just one with no matching registered point."""
    report_root_path = os.path.abspath(resolve_report_root(args))
    test, test_point, warning = joblib.resolve_test_identity(
        args.suite, args.benchmark, resolve_dest_roots(args))
    if warning:
        print("wspy-testpoint: warning: %s" % warning, file=sys.stderr)
    test_point_dir = os.path.join(report_root_path, args.suite, test, test_point, args.machine)
    runs_json_path = os.path.join(test_point_dir, RUNS_JSON_NAME)
    return report_root_path, test, test_point, runs_json_path


def read_run_passes(output_root, suite, benchmark, run_id):
    """Frozenset of this run's own pass names (run-level manifest.json's passes[] -- wspy-run's unified
    --suite/--benchmark layout), used to detect a run whose collection scope differs from its test
    point's majority (extra tree/IBS/symbol-sample passes the others lack -> supplementary, not a
    repeated trial of the same measurement). Empty frozenset if no run-level manifest.json exists (a
    bare wspy run dropped into this layout by hand) -- treated as its own distinct "scope" by the
    majority-vote logic below, not silently ignored."""
    manifest = joblib.read_run_manifest(os.path.join(output_root, suite, benchmark, run_id, joblib.RUN_MANIFEST_NAME))
    if not manifest:
        return frozenset()
    return frozenset(p.get("name") for p in manifest.get("passes", []) if p.get("name"))


def enumerate_candidate_runs(output_root, suite, benchmark, hostname):
    """Every run directory under <output_root>/<suite>/<benchmark>/ whose manifest-derived hostname
    exactly matches `hostname` -- deliberately not discover_run_history()'s fuzzy substring filter
    (built for a human typing into a search box), and deliberately a targeted listdir of one already-
    known suite/benchmark directory rather than that function's whole-output-root scan, which has
    nothing to offer here since suite/benchmark are already fixed inputs."""
    bench_dir = os.path.join(output_root, suite, benchmark)
    candidates = []
    if not os.path.isdir(bench_dir):
        return candidates
    for run_id in sorted(os.listdir(bench_dir)):
        run_dir = os.path.join(bench_dir, run_id)
        if not os.path.isdir(run_dir):
            continue
        mtime = os.path.getmtime(run_dir)
        entry = web_export.load_run_history_entry(output_root, suite, benchmark, run_id, mtime)
        if (entry.get("hostname") or "") != hostname:
            continue
        entry["passes"] = read_run_passes(output_root, suite, benchmark, run_id)
        candidates.append(entry)
    return candidates


def majority_pass_set(candidates):
    if not candidates:
        return frozenset()
    counts = Counter(c["passes"] for c in candidates)
    return counts.most_common(1)[0][0]


def compute_default_role(entry, majority_passes):
    if entry["status"] == "failed":
        return "excluded", "status=failed"
    if entry["passes"] == majority_passes:
        return "stats-pool", "status=%s, majority pass-set" % entry["status"]
    return "supplementary", "status=%s, pass-set differs from this test point's majority (%s vs %s)" % (
        entry["status"], sorted(entry["passes"]), sorted(majority_passes))


def load_existing(path):
    if not os.path.isfile(path):
        return None
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError):
        print("wspy-testpoint: warning: %s exists but could not be parsed -- starting fresh" % path,
              file=sys.stderr)
        return None
    if data.get("schema_version") != RUNS_JSON_SCHEMA_VERSION:
        print("wspy-testpoint: warning: %s has schema_version=%r (expected %r) -- starting fresh" % (
            path, data.get("schema_version"), RUNS_JSON_SCHEMA_VERSION), file=sys.stderr)
        return None
    return data


def merge_roles(existing, candidates, majority_passes):
    """Returns (runs_by_id, primary_run_id) -- existing human_set=true rows are carried forward
    unchanged; every other row (previously auto-computed, or newly seen this run) gets a freshly
    computed default. Rows in `existing` whose run_id isn't among `candidates` this time (the run
    directory was since cleaned up from --output-root) are kept as-is too -- role assignment is a
    historical decision worth keeping, not just a live view (mirrors the deep-dive's own "excluded runs
    stay in history for traceability" framing)."""
    existing_by_id = {r["run_id"]: r for r in (existing or {}).get("runs", [])}
    candidates_by_id = {c["run_id"]: c for c in candidates}

    runs_by_id = dict(existing_by_id)
    for run_id, entry in candidates_by_id.items():
        prior = existing_by_id.get(run_id)
        if prior and prior.get("human_set"):
            continue
        role, reason = compute_default_role(entry, majority_passes)
        runs_by_id[run_id] = {
            "run_id": run_id, "benchmark": entry["benchmark"], "hostname": entry["hostname"],
            "status": entry["status"], "command": entry["workload_str"], "start_time": entry["start_time"],
            "role": role, "human_set": False, "reason": reason,
        }

    primary_run_id = (existing or {}).get("primary_run_id")
    primary_human_set = bool((existing or {}).get("primary_human_set"))
    if not primary_human_set:
        stats_pool = [r for r in runs_by_id.values() if r["role"] == "stats-pool"]
        stats_pool.sort(key=lambda r: r.get("start_time") or "", reverse=True)
        primary_run_id = stats_pool[0]["run_id"] if stats_pool else None

    return runs_by_id, primary_run_id, primary_human_set


def apply_overrides(runs_by_id, set_overrides, primary_override):
    """Mutates runs_by_id in place; returns primary_human_set's new value (True if this invocation's
    --primary was given, unchanged otherwise -- a run's own human_set tracks its *role* override, which
    is a separate decision from whether it was explicitly chosen as primary, so this can't reuse that
    same flag: --primary alone (no --set for that run) must still survive the next re-run)."""
    for run_id, role in set_overrides:
        if run_id not in runs_by_id:
            raise KeyError(run_id)
        runs_by_id[run_id]["role"] = role
        runs_by_id[run_id]["human_set"] = True
        runs_by_id[run_id]["reason"] = "human override (--set)"
    if primary_override is not None and primary_override not in runs_by_id:
        raise KeyError(primary_override)
    return primary_override is not None


def commit_runs_json(report_root_path, rel_path, message):
    return report_root.commit_paths(report_root_path, [rel_path], message)


def print_summary(data):
    primary = data.get("primary_run_id")
    print("%s/%s/%s/%s (%d run(s)):" % (
        data["suite"], data["test"], data["test_point"], data["machine"], len(data["runs"])))
    for r in sorted(data["runs"], key=lambda r: r.get("start_time") or ""):
        marker = " [primary]" if r["run_id"] == primary else ""
        human = "human-set" if r["human_set"] else "auto"
        print("  %-12s %-13s %s%s  (%s: %s)" % (
            r["role"], r["run_id"], r["status"], marker, human, r["reason"]))


def cmd_select_runs(args):
    output_root = os.path.abspath(args.output_root)
    hostname = args.hostname or socket.gethostname()
    report_root_path, test, test_point, runs_json_path = resolve_test_point_paths(args)

    if not args.dry_run:
        ok, msg = report_root.ensure_report_root(report_root_path, args.report_root_remote)
        print("wspy-testpoint: %s" % msg, file=sys.stderr)
        if not ok:
            return 1

    candidates = enumerate_candidate_runs(output_root, args.suite, args.benchmark, hostname)
    if not candidates:
        print("wspy-testpoint: no runs found under %s for suite=%r benchmark=%r hostname=%r" % (
            output_root, args.suite, args.benchmark, hostname), file=sys.stderr)
        return 1
    majority_passes = majority_pass_set(candidates)

    existing = load_existing(runs_json_path)

    runs_by_id, primary_run_id, primary_human_set = merge_roles(existing, candidates, majority_passes)

    set_overrides = []
    for spec in args.set or []:
        if "=" not in spec:
            print("wspy-testpoint: error: --set %r must be RUN_ID=ROLE" % spec, file=sys.stderr)
            return 2
        run_id, role = spec.split("=", 1)
        if role not in ROLES:
            print("wspy-testpoint: error: --set %s: role must be one of %s" % (spec, ", ".join(ROLES)),
                  file=sys.stderr)
            return 2
        set_overrides.append((run_id, role))
    try:
        this_run_set_primary = apply_overrides(runs_by_id, set_overrides, args.primary)
    except KeyError as e:
        print("wspy-testpoint: error: run_id %r is not among this test point's candidate runs" % e.args[0],
              file=sys.stderr)
        return 2
    if this_run_set_primary:
        primary_run_id = args.primary
        primary_human_set = True

    stats_pool_commands = {r["command"] for r in runs_by_id.values() if r["role"] == "stats-pool"}
    if len(stats_pool_commands) > 1:
        print("wspy-testpoint: warning: stats-pool runs don't all share the same command text -- "
              "wspy-summary --command matches exact text, so this will silently split into separate "
              "buckets:\n  %s" % "\n  ".join(sorted(c or "(unknown)" for c in stats_pool_commands)),
              file=sys.stderr)

    data = {
        "schema_version": RUNS_JSON_SCHEMA_VERSION,
        "suite": args.suite, "test": test, "test_point": test_point, "machine": args.machine,
        # Deliberately no "generated_at" timestamp: this file is committed to a git repo, which already
        # tracks when it last meaningfully changed (git log) -- a fresh timestamp on every invocation
        # would make every run "look" different and defeat commit_runs_json()'s idempotent no-op path.
        "primary_run_id": primary_run_id,
        "primary_human_set": primary_human_set,
        "runs": sorted(runs_by_id.values(), key=lambda r: r["run_id"]),
    }

    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print_summary(data)

    if args.dry_run:
        print("wspy-testpoint: --dry-run -- not writing %s or committing" % runs_json_path, file=sys.stderr)
        return 0

    os.makedirs(os.path.dirname(runs_json_path), exist_ok=True)
    with open(runs_json_path, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")

    rel_path = os.path.relpath(runs_json_path, report_root_path)
    ok, msg = commit_runs_json(
        report_root_path, rel_path,
        "Update run role-assignment for %s/%s/%s/%s" % (args.suite, test, test_point, args.machine))
    print("wspy-testpoint: %s" % msg, file=sys.stderr)
    return 0 if ok else 1


# escape_like()/resolve_store_pass_rows() come from joblib.py (import block above) -- shared with
# server.py's characterization-badge generator, which hits this exact same directory-name-vs-store-
# run_id mismatch.


def split_by_store_presence(db_path, suite, benchmark, stats_pool):
    """Returns (present, missing) -- which of stats_pool's runs actually have at least one matching row
    in the store's `runs` table (resolve_store_pass_rows() above), checked with a read-only query rather
    than blindly trusting runs.json and letting wspy-summary silently report zero matches with no
    indication why. Never ingests on demand -- same "requires a pre-populated --db" contract
    wspy-summary/wspy-archetype themselves already have, and a run only has a run-index record to
    ingest at all if it was launched with --run-index in the first place, so there's no reliable way
    to synthesize one retroactively for a run that predates that. Each present run gets two new keys:
    store_pass_ids (every resolved store run_id, for wspy-summary's --run-id, one per pass so aggregate
    covers the run's full collection scope) and store_pass_configs ((run_id, config_name) pairs, for
    collect_archetype_scorecards() to pick one representative pass)."""
    if not os.path.isfile(db_path):
        return [], list(stats_pool)
    conn = sqlite3.connect(db_path)
    try:
        cur = conn.cursor()
        present, missing = [], []
        for r in stats_pool:
            rows = joblib.resolve_store_pass_rows(cur, r["hostname"], suite, benchmark, r["run_id"])
            if rows:
                present.append(dict(r, store_pass_ids=[row[0] for row in rows], store_pass_configs=rows))
            else:
                missing.append(r)
        return present, missing
    finally:
        conn.close()


def load_stats_pool_present(args, runs_json_path):
    """Returns (data, present) -- runs.json load + stats-pool role filter + store-presence split,
    shared by aggregate and render so they can't drift into different resolution logic for "which
    runs actually feed the numbers." Returns (None, None) with an explanatory error/warning already
    printed on any failure (missing runs.json, no stats-pool runs, none of them in the store)."""
    if not os.path.isfile(runs_json_path):
        print("wspy-testpoint: error: %s not found -- run `wspy-testpoint select-runs --suite %s "
              "--benchmark %s --machine %s` first" % (
                  runs_json_path, args.suite, args.benchmark, args.machine), file=sys.stderr)
        return None, None
    data = load_existing(runs_json_path)
    if data is None:
        return None, None  # load_existing() already printed why (missing/unparseable/schema mismatch)

    stats_pool = [r for r in data["runs"] if r["role"] == "stats-pool"]
    if not stats_pool:
        print("wspy-testpoint: no stats-pool runs in %s -- nothing to aggregate" % runs_json_path,
              file=sys.stderr)
        return None, None

    present, missing = split_by_store_presence(args.db, args.suite, args.benchmark, stats_pool)
    if missing:
        print("wspy-testpoint: warning: %d of %d stats-pool run(s) not found in %s -- run `wspy-store "
              "--db %s --run-index <run-index.jsonl>` to ingest them first:\n  %s" % (
                  len(missing), len(stats_pool), args.db, args.db,
                  "\n  ".join("%s:%s" % (r["hostname"], r["run_id"]) for r in missing)), file=sys.stderr)
    if not present:
        print("wspy-testpoint: none of this test point's stats-pool runs are in %s -- nothing to "
              "aggregate" % args.db, file=sys.stderr)
        return None, None
    return data, present


def cmd_aggregate(args):
    _, test, test_point, runs_json_path = resolve_test_point_paths(args)
    data, present = load_stats_pool_present(args, runs_json_path)
    if data is None:
        return 1

    argv = [args.wspy_summary_bin, "--db", args.db]
    for r in present:
        for store_run_id in r["store_pass_ids"]:
            argv += ["--run-id", "%s:%s" % (r["hostname"], store_run_id)]
    if args.csv:
        argv.append("--csv")
    for m in args.metric or []:
        argv += ["--metric", m]
    if args.strict:
        argv.append("--strict")
    if args.quiet:
        argv.append("--quiet")

    print("wspy-testpoint: aggregating %d stats-pool run(s) for %s/%s/%s/%s" % (
        len(present), args.suite, test, test_point, args.machine), file=sys.stderr)
    try:
        proc = subprocess.run(argv)
    except OSError as e:
        print("wspy-testpoint: error: failed to launch %s: %s" % (args.wspy_summary_bin, e),
              file=sys.stderr)
        return 1
    return proc.returncode


def render_section_markdown(rows):
    lines = ["| metric | n | min | max | mean | stddev | cv% | verdict |",
             "|---|---|---|---|---|---|---|---|"]
    for r in rows:
        lines.append("| %s | %s | %s | %s | %s | %s | %s | %s |" % (
            r["metric"], r["n"], r["min"], r["max"], r["mean"], r["stddev"], r["cv_percent"],
            r["verdict"]))
    return "\n".join(lines) + "\n"


def render_warn_callout(rows):
    """None if every reported metric verdict is PASS -- callers skip the whole section rather than
    rendering an empty "no warnings" table. wspy-summary's own verdict strings (PASS, or WARN: plus
    thin/noisy/mixed-pmu/mixed-env) are surfaced verbatim, not re-interpreted -- this tool narrates
    what was already computed, same "classification-by-code" rule wspy-analyze's own prompts follow."""
    warns = [r for r in rows if r.get("verdict") != "PASS"]
    if not warns:
        return None
    lines = ["The following metrics carry a non-`PASS` verdict -- see `wspy-summary --help` for what "
             "each `WARN:` reason means (`thin`/`noisy`/`mixed-pmu`/`mixed-env`):", "",
             "| metric | verdict |", "|---|---|"]
    for r in warns:
        lines.append("| %s | %s |" % (r["metric"], r["verdict"]))
    return "\n".join(lines) + "\n"


def render_supplementary_section(data):
    """None if this test point has no supplementary-role runs. Lists them by run_id/reason only --
    which specific artifact from a supplementary run (an extra chart, a process-tree view) is worth
    pulling in isn't decided by anything in runs.json today, so that stays a human's own follow-up for
    now rather than a guess this tool makes; see the deep-dive's own incremental scoping."""
    supp = [r for r in data["runs"] if r["role"] == "supplementary"]
    if not supp:
        return None
    lines = ["Runs with a different collection scope than the stats-pool majority -- not included in "
             "the statistics above, kept here for traceability:", "",
             "| run_id | hostname | reason |", "|---|---|---|"]
    for r in supp:
        lines.append("| %s | %s | %s |" % (r["run_id"], r["hostname"], r["reason"]))
    return "\n".join(lines) + "\n"


def pick_archetype_pass_id(cur, r):
    """--run takes exactly one store run_id (unlike aggregate's --run-id, which is repeatable), but a
    real run has one store row per collection pass (resolve_store_pass_rows()). Thin wrapper over
    joblib.pick_counters_pass_id() (shared with server.py's characterization-badge generator) adapting
    this module's own runs.json-shaped entry to that function's plain pass-rows list. Needs an open
    cursor (issue #270) so it can prefer a pass that actually has run_features data over one merely
    named "counters" -- see pick_counters_pass_id()'s own docstring."""
    return joblib.pick_counters_pass_id(cur, r["hostname"], r["store_pass_configs"])


def collect_archetype_scorecards(wspy_archetype_bin, db_path, present):
    """Runs `wspy-archetype --run <hostname>:<run_id>` once per present run (no bulk --command/
    --hostname filter needed here, unlike aggregate's own wspy-summary call -- --run already names an
    exact run, so the redo-vs-repeat ambiguity that motivated --run-id in summary.c doesn't apply),
    against one representative store pass per run (pick_archetype_pass_id()), and parses its key=value
    output (archetype.c's print_trace_field(): one `key=value` per line, no quoting) into a dict per run.
    A run wspy-archetype can't find -- shouldn't happen, since split_by_store_presence() already
    confirmed it's in the store, but degrade rather than crash if it somehow is -- is skipped with a
    warning, same as a missing/failing binary (an empty result list), rather than aborting the whole
    render over an optional section."""
    scorecards = []
    conn = sqlite3.connect(db_path)
    try:
        cur = conn.cursor()
        for r in present:
            pass_run_id = pick_archetype_pass_id(cur, r)
            argv = [wspy_archetype_bin, "--db", db_path, "--run", "%s:%s" % (r["hostname"], pass_run_id)]
            try:
                proc = subprocess.run(argv, capture_output=True, text=True)
            except OSError as e:
                print("wspy-testpoint: warning: failed to launch %s: %s -- skipping archetype "
                      "characterization" % (wspy_archetype_bin, e), file=sys.stderr)
                return scorecards
            if proc.returncode != 0:
                print("wspy-testpoint: warning: %s --run %s:%s (run %s) failed: %s" % (
                    wspy_archetype_bin, r["hostname"], pass_run_id, r["run_id"], proc.stderr.strip()),
                    file=sys.stderr)
                continue
            fields = {"run_id": r["run_id"]}
            for line in proc.stdout.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    fields[k] = v
            scorecards.append(fields)
    finally:
        conn.close()
    return scorecards


def collect_wordpress_archetype_scorecards(wspy_archetype_bin, wp_cfg, suite, test, test_point,
                                            local_machine):
    """INVESTIGATION.md 4.3 item 23: characterizes every machine published on WordPress for this test
    point other than local_machine (this invocation's own --machine, already covered by
    collect_archetype_scorecards() above) -- the post-publish half of the pre-publish/post-publish
    split settled for this item: wspy-analyze's own AI narrative stays local-data-only (generated
    before/independent of publishing), this is what makes the *characterization* section see peers
    it currently can't at all.

    For each such machine, web_export.recover_machine_metrics_from_wordpress() (item 21) supplies a
    {metric: mean} guest feature vector, written to a temp JSON file and scored via
    `wspy-archetype --run-guest <file>` (item 23's own archetype.c addition -- no database, no
    hostname:run_id needed, since this machine has no local wspy-store presence at all). Degrades to
    an empty list, never an error: no WordPress configured, no other machine published here, or an
    individual machine's recovery/scoring step failing are all silently skipped (with a stderr
    warning for the latter) rather than aborting the whole render over an optional section."""
    if not wp_cfg:
        return []
    status = web_export.resolve_reference_matrix_row_publish_status(wp_cfg, suite, test, test_point)
    scorecards = []
    for machine in sorted(m for m in status if m != local_machine):
        rows = web_export.recover_machine_metrics_from_wordpress(
            wp_cfg, suite, test, test_point, machine)
        if not rows:
            continue
        guest = {r["metric"]: float(r["mean"]) for r in rows}
        fd, tmp_path = tempfile.mkstemp(suffix=".json", prefix="wspy-archetype-guest-")
        try:
            with os.fdopen(fd, "w") as f:
                json.dump(guest, f)
            try:
                proc = subprocess.run([wspy_archetype_bin, "--run-guest", tmp_path],
                                       capture_output=True, text=True)
            except OSError as e:
                print("wspy-testpoint: warning: failed to launch %s: %s -- skipping WordPress "
                      "characterization for %s" % (wspy_archetype_bin, e, machine), file=sys.stderr)
                continue
            if proc.returncode != 0:
                print("wspy-testpoint: warning: %s --run-guest for %s failed: %s" % (
                    wspy_archetype_bin, machine, proc.stderr.strip()), file=sys.stderr)
                continue
        finally:
            os.unlink(tmp_path)
        fields = {"machine": machine}
        for line in proc.stdout.splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                fields[k] = v
        scorecards.append(fields)
    return scorecards


def render_archetype_section(scorecards, wordpress_scorecards=None):
    """None if nothing at all was collected (neither real scorecards nor WordPress-recovered ones)
    or if every one of them came back "unknown" (nothing measured worth reporting). Otherwise a
    per-run table plus a consistent/diverges verdict across whichever runs *did* report a known
    dominance -- resource_dominance is wspy-archetype's own "headline axis" (its --help's own words),
    so this is the one worth calling out explicitly; a run with insufficient data to classify doesn't
    count against agreement, it's simply not evidence either way, not a vote for "diverges".

    wordpress_scorecards (item 23, collect_wordpress_archetype_scorecards()'s own return) is rendered
    as a visibly distinct second block -- a machine-keyed table plus a simple agree/differs note
    against this machine's own verdict -- never merged into the "Consistent"/"Diverges" computation
    above, the same visible-provenance principle item 21/22 already established: this data has no
    wspy-summary reliability verdict behind it, and today only the topdown axes have exact-name
    alignment with real store features (item 24's own still-open residual)."""
    wordpress_scorecards = wordpress_scorecards or []
    known = [s for s in scorecards if s.get("resource_dominance", "unknown") != "unknown"]
    wp_known = [s for s in wordpress_scorecards if s.get("resource_dominance", "unknown") != "unknown"]
    if not known and not wp_known:
        return None

    lines = []
    if known:
        lines += ["| run_id | resource_dominance | confidence |", "|---|---|---|"]
        for s in scorecards:
            dom = s.get("resource_dominance", "unknown")
            pct = s.get("resource_dominance_pct")
            dom_display = "%s (%s%%)" % (dom, pct) if pct else dom
            lines.append("| %s | %s | %s |" % (s["run_id"], dom_display, s.get("confidence", "unknown")))
        lines.append("")
        labels = {s["resource_dominance"] for s in known}
        if len(labels) == 1:
            lines.append("**Consistent** -- `resource_dominance` agrees (`%s`) across all %d run(s) "
                          "with archetype data." % (next(iter(labels)), len(known)))
        else:
            counts = Counter(s["resource_dominance"] for s in known)
            breakdown = ", ".join("%d run(s) `%s`" % (n, label) for label, n in counts.most_common())
            lines.append("**Diverges** -- `resource_dominance` does not agree across stats-pool runs: "
                          "%s. This may indicate a genuinely unstable workload characterization, not "
                          "just measurement noise -- worth a closer look." % breakdown)

    if wp_known:
        if lines:
            lines.append("")
        lines.append("**WordPress-recovered peers** -- machines with no local `runs.json`/store "
                      "presence, characterized from their own already-published pages instead:")
        lines.append("")
        lines += ["| machine | resource_dominance | confidence |", "|---|---|---|"]
        for s in wordpress_scorecards:
            dom = s.get("resource_dominance", "unknown")
            pct = s.get("resource_dominance_pct")
            dom_display = "%s (%s%%)" % (dom, pct) if pct else dom
            lines.append("| %s | %s | %s |" % (s["machine"], dom_display, s.get("confidence", "unknown")))
        lines.append("")
        local_labels = {s["resource_dominance"] for s in known}
        wp_labels = {s["resource_dominance"] for s in wp_known}
        if local_labels and wp_labels:
            if local_labels == wp_labels and len(local_labels) == 1:
                lines.append("Agrees with this machine's own `resource_dominance` (`%s`)." %
                              next(iter(local_labels)))
            else:
                lines.append("Differs from this machine's own `resource_dominance` -- worth a closer "
                              "look, kept in mind that this data has no `wspy-summary` reliability "
                              "verdict behind it.")
    return "\n".join(lines) + "\n"


def sync_sections(test_point_dir, sections):
    """Writes each (key, title, content_markdown) in `sections` to
    <test_point_dir>/sections/<key>.md. Returns [(key, title, rel_path), ...] in the same order, for
    sync_curation_blocks() to reconcile against the persisted block list."""
    sections_dir = os.path.join(test_point_dir, SECTIONS_DIR_NAME)
    os.makedirs(sections_dir, exist_ok=True)
    written = []
    for key, title, content in sections:
        rel = os.path.join(SECTIONS_DIR_NAME, "%s.md" % key)
        with open(os.path.join(test_point_dir, rel), "w") as f:
            f.write(content)
        written.append((key, title, rel))
    return written


def sync_curation_blocks(curation, written_sections):
    """Merges written_sections into curation["blocks"] in place. A block whose source_file already
    exists (from a prior render) keeps its title/depth/commentary/position exactly as a human may have
    left them -- sync_sections() already refreshed the file's own content, this only adds a block for a
    section that's newly appearing. A block for a section that no longer has data this run is left in
    place too, not removed -- same "don't delete history" precedent select-runs' own merge_roles()
    already established for runs no longer present in --output-root."""
    blocks = curation.setdefault("blocks", [])
    existing_files = {b.get("source_file") for b in blocks if b.get("kind") == "artifact"}
    for _, title, rel in written_sections:
        if rel not in existing_files:
            blocks.append(web_export.new_block("artifact", source_file=rel, source_kind="markdown",
                                                 title=title))
    return curation


def save_curation_no_timestamp(test_point_dir, curation):
    """Like web/server.py's own save_curation(), minus the "updated" timestamp it always stamps on
    every save -- appropriate for a human clicking Save in the studio (a real edit just happened), but
    wrong here: it would make curation.json "look" different on every automated re-render regardless of
    whether the actual sections/blocks changed at all, defeating commit_paths()'s idempotent no-op path
    the same way an earlier "generated_at" field defeated it for runs.json (see cmd_select_runs's own
    data dict comment) -- git history already tracks when this file last meaningfully changed."""
    curation["schema_version"] = web_export.CURATION_SCHEMA_VERSION
    path = os.path.join(test_point_dir, joblib.CURATION_NAME)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(curation, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def cmd_render(args):
    report_root_path, test, test_point, runs_json_path = resolve_test_point_paths(args)
    test_point_dir = os.path.dirname(runs_json_path)

    if not args.dry_run:
        ok, msg = report_root.ensure_report_root(report_root_path, args.report_root_remote)
        print("wspy-testpoint: %s" % msg, file=sys.stderr)
        if not ok:
            return 1

    data, present = load_stats_pool_present(args, runs_json_path)
    if data is None:
        return 1

    argv = [args.wspy_summary_bin, "--db", args.db, "--csv", "--quiet"]
    for r in present:
        for store_run_id in r["store_pass_ids"]:
            argv += ["--run-id", "%s:%s" % (r["hostname"], store_run_id)]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        print("wspy-testpoint: error: failed to launch %s: %s" % (args.wspy_summary_bin, e),
              file=sys.stderr)
        return 1
    if proc.returncode != 0:
        print("wspy-testpoint: error: %s failed:\n%s" % (args.wspy_summary_bin, proc.stderr.strip()),
              file=sys.stderr)
        return 1
    rows = joblib.parse_summary_csv(proc.stdout)
    if not rows:
        print("wspy-testpoint: warning: %s produced no rows for this test point's stats-pool runs" %
              args.wspy_summary_bin, file=sys.stderr)

    grouped = {}
    for r in rows:
        group = joblib.resolve_column_group(r["metric"]) or "other"
        grouped.setdefault(group, []).append(r)

    sections = []
    warn_md = render_warn_callout(rows)
    if warn_md:
        sections.append(("_warnings", "Reliability warnings", warn_md))
    scorecards = collect_archetype_scorecards(args.wspy_archetype_bin, args.db, present)
    wordpress_scorecards = collect_wordpress_archetype_scorecards(
        args.wspy_archetype_bin, load_config(), args.suite, test, test_point, args.machine)
    archetype_md = render_archetype_section(scorecards, wordpress_scorecards)
    if archetype_md:
        sections.append(("_archetype", "Workload characterization", archetype_md))
    for group in sorted(grouped):
        sections.append((group, GROUP_TITLES.get(group, "Other metrics"),
                          render_section_markdown(grouped[group])))
    supp_md = render_supplementary_section(data)
    if supp_md:
        sections.append(("_supplementary", "Supplementary runs", supp_md))

    if args.dry_run:
        print("wspy-testpoint: --dry-run -- would write %d section(s) under %s and render README.md" % (
            len(sections), test_point_dir), file=sys.stderr)
        for _, title, _ in sections:
            print("  - %s" % title, file=sys.stderr)
        return 0

    os.makedirs(test_point_dir, exist_ok=True)
    written_sections = sync_sections(test_point_dir, sections)

    curation = web_export.load_curation(test_point_dir) or {"blocks": [], "overview_note": ""}
    sync_curation_blocks(curation, written_sections)
    save_curation_no_timestamp(test_point_dir, curation)

    included = [b for b in curation["blocks"] if b.get("depth", "none") != "none"]
    title = "%s / %s on %s" % (test, test_point, args.machine)
    readme_md = web_export.render_export_markdown(
        test_point_dir, "", title, curation.get("overview_note", ""), included)
    readme_path = os.path.join(test_point_dir, "README.md")
    with open(readme_path, "w") as f:
        f.write(readme_md)

    rel_paths = [os.path.relpath(readme_path, report_root_path),
                 os.path.relpath(os.path.join(test_point_dir, joblib.CURATION_NAME), report_root_path)]
    rel_paths += [os.path.relpath(os.path.join(test_point_dir, rel), report_root_path)
                  for _, _, rel in written_sections]
    ok, msg = report_root.commit_paths(
        report_root_path, rel_paths,
        "Render README for %s/%s/%s/%s" % (args.suite, test, test_point, args.machine))
    print("wspy-testpoint: wrote %s -- %s" % (readme_path, msg), file=sys.stderr)
    return 0 if ok else 1


def cmd_characterize(args):
    """Read-only counterpart to render's own "Workload characterization" section (item 5's
    analysis-feed hookup, INVESTIGATION.md 4.3 item 5) -- resolves this test point + machine's
    stats-pool scorecards (collect_archetype_scorecards()) and any WordPress-recovered peer
    scorecards (collect_wordpress_archetype_scorecards(), item 23) and prints them as one JSON object,
    with no report-root write/commit at all (unlike render, which folds the same two calls into a
    full README render + git commit). Exists so web/server.py's live Reference-tab pages can reuse
    this exact characterization logic without a circular import -- wspy-testpoint already imports
    server.py (as web_export), not the other way around, so server.py can't import these functions
    back directly. Never clones/creates the report-root (unlike select-runs/render) -- a missing
    runs.json just degrades to the same "nothing to characterize" error load_stats_pool_present()
    already gives every other subcommand, read-only throughout."""
    _, test, test_point, runs_json_path = resolve_test_point_paths(args)
    data, present = load_stats_pool_present(args, runs_json_path)
    if data is None:
        return 1

    scorecards = collect_archetype_scorecards(args.wspy_archetype_bin, args.db, present)
    wordpress_scorecards = collect_wordpress_archetype_scorecards(
        args.wspy_archetype_bin, load_config(), args.suite, test, test_point, args.machine)
    print(json.dumps({"scorecards": scorecards, "wordpress_scorecards": wordpress_scorecards}))
    return 0


def add_test_point_args(parser):
    """--suite/--benchmark/--machine/--report-root/--phoronix-dest-root/--cpu2026-dest-root/
    --dest-root -- shared by every subcommand that needs to resolve a test point's report-root path
    (resolve_test_point_paths()), factored out so select-runs and aggregate can't drift into slightly
    different flag definitions for the same inputs. --phoronix-dest-root/--cpu2026-dest-root are kept
    as-is (rather than removed) since they're already documented in README.md and exercised by
    tests/testpoint_smoke.sh's own regression coverage for PR #196 -- INVESTIGATION.md 4.4(a)'s "CLI
    flag/identity consistency pass" adds the generic --dest-root SUITE=PATH alongside them (repeatable,
    resolve_dest_roots() below merges all three forms into one {suite: dest_root} dict) as the
    extension point a *third* suite plugs into, rather than growing this function a new bespoke flag
    per suite forever -- see web/joblib.py's TEST_POINT_SUITES for the matching registry on the
    resolution side."""
    parser.add_argument("--suite", required=True, help="suite name, e.g. phoronix, cpu2026")
    parser.add_argument("--benchmark", required=True,
                         help="benchmark name (wspy-run's own naming) -- for phoronix, this is a "
                              "materialized test point's identity (bare_name-options_slug); for "
                              "cpu2026, a registered benchmark point's identity (bench-tag-tune)")
    parser.add_argument("--machine", required=True,
                         help="human-assigned machine slug (e.g. amd-395, doc/REPORT_HIERARCHY.md) -- "
                              "the report-root path segment, distinct from --hostname")
    parser.add_argument("--report-root", default=None,
                         help="report-root git clone path (default: wspy-publish's configured "
                              "report_root, else %s)" % report_root.DEFAULT_REPORT_ROOT)
    parser.add_argument("--phoronix-dest-root", default=None,
                         help="materialized Phoronix test-point directory (default: %s) -- shorthand "
                              "for --dest-root phoronix=PATH" % joblib.DEFAULT_DEST_ROOTS["phoronix"])
    parser.add_argument("--cpu2026-dest-root", default=None,
                         help="materialized cpu2026 benchmark-point directory (default: %s) -- shorthand "
                              "for --dest-root cpu2026=PATH" % joblib.DEFAULT_DEST_ROOTS["cpu2026"])
    parser.add_argument("--dest-root", action="append", default=[], metavar="SUITE=PATH",
                         help="materialized-test-point directory for an arbitrary suite (repeatable), "
                              "e.g. --dest-root phoronix=/other/path -- the generic form of "
                              "--phoronix-dest-root/--cpu2026-dest-root above; a new suite beyond "
                              "phoronix/cpu2026 is only ever reachable this way")


def resolve_dest_roots(args):
    """Merges joblib.DEFAULT_DEST_ROOTS with any --phoronix-dest-root/--cpu2026-dest-root overrides
    and repeatable --dest-root SUITE=PATH entries (in that precedence order -- --dest-root wins,
    since it's the more specific, later-parsed override for the same suite) into the one
    {suite: dest_root} dict resolve_test_identity()/enumerate_reference_matrix_cells() actually take.
    The single place all three input forms funnel through, so a new suite only ever needs
    --dest-root plus a web/joblib.py TEST_POINT_SUITES entry, never new merge logic here too."""
    dest_roots = dict(joblib.DEFAULT_DEST_ROOTS)
    if args.phoronix_dest_root:
        dest_roots["phoronix"] = args.phoronix_dest_root
    if args.cpu2026_dest_root:
        dest_roots["cpu2026"] = args.cpu2026_dest_root
    for entry in args.dest_root:
        if "=" not in entry:
            print("wspy-testpoint: warning: ignoring malformed --dest-root %r (want SUITE=PATH)" % entry,
                  file=sys.stderr)
            continue
        suite, path = entry.split("=", 1)
        dest_roots[suite] = path
    return dest_roots


def main():
    ap = argparse.ArgumentParser(
        description="Run selection / role-assignment, aggregation, and README rendering for a wspy "
                    "test point + machine (INVESTIGATION.md's test-point README deep-dive, "
                    "Tier 3 item 5).")
    sub = ap.add_subparsers(dest="command", required=True)

    sr = sub.add_parser("select-runs", help="resolve and persist run roles for one test point + machine")
    add_test_point_args(sr)
    sr.add_argument("--hostname", default=None,
                     help="actual hostname to filter the run set by (default: this machine's own "
                          "hostname) -- no mapping to --machine's slug is assumed")
    sr.add_argument("--output-root", default=DEFAULT_OUTPUT_ROOT,
                     help="wspy-run --suite/--benchmark unified layout root (default: %(default)s)")
    sr.add_argument("--report-root-remote", default=report_root.DEFAULT_REPORT_ROOT_REMOTE,
                     help="report-root git remote to clone from if --report-root doesn't exist yet "
                          "(default: %(default)s) -- override for testing against a local/fork remote")
    sr.add_argument("--set", action="append", metavar="RUN_ID=ROLE",
                     help="human override for one run's role (repeatable); ROLE is one of %s" %
                          ", ".join(ROLES))
    sr.add_argument("--primary", default=None, metavar="RUN_ID",
                     help="human override for which run is primary")
    sr.add_argument("--dry-run", action="store_true",
                     help="compute and print, but don't touch the report-root clone or write/commit")
    sr.add_argument("--json", action="store_true", help="print the full resolved data as JSON")
    sr.set_defaults(func=cmd_select_runs)

    ag = sub.add_parser("aggregate",
                         help="aggregate a test point's stats-pool runs via wspy-summary --run-id")
    add_test_point_args(ag)
    ag.add_argument("--db", default=DEFAULT_STORE_DB,
                     help="normalized wspy-store database (default: %(default)s)")
    ag.add_argument("--wspy-summary-bin", default=os.path.join(SCRIPT_DIR, "wspy-summary"),
                     help="wspy-summary binary (default: %(default)s)")
    ag.add_argument("--csv", action="store_true", help="machine-readable CSV output (passed through)")
    ag.add_argument("--metric", action="append", metavar="NAME",
                     help="only include this metric; may be repeated (passed through)")
    ag.add_argument("--strict", action="store_true",
                     help="exit non-zero on any WARN verdict or thin bucket (passed through)")
    ag.add_argument("--quiet", action="store_true",
                     help="suppress wspy-summary's trailing summary line (passed through)")
    ag.set_defaults(func=cmd_aggregate)

    rn = sub.add_parser("render",
                         help="render a test point's stats-pool aggregate into a curated README.md")
    add_test_point_args(rn)
    rn.add_argument("--db", default=DEFAULT_STORE_DB,
                     help="normalized wspy-store database (default: %(default)s)")
    rn.add_argument("--wspy-summary-bin", default=os.path.join(SCRIPT_DIR, "wspy-summary"),
                     help="wspy-summary binary (default: %(default)s)")
    rn.add_argument("--wspy-archetype-bin", default=os.path.join(SCRIPT_DIR, "wspy-archetype"),
                     help="wspy-archetype binary, for the cross-run workload-characterization section "
                          "(default: %(default)s) -- a missing/failing binary just skips that section")
    rn.add_argument("--report-root-remote", default=report_root.DEFAULT_REPORT_ROOT_REMOTE,
                     help="report-root git remote to clone from if --report-root doesn't exist yet "
                          "(default: %(default)s) -- override for testing against a local/fork remote")
    rn.add_argument("--dry-run", action="store_true",
                     help="compute and print which sections would be written, but touch nothing on disk")
    rn.set_defaults(func=cmd_render)

    ch = sub.add_parser("characterize",
                         help="print archetype characterization for a test point + machine as JSON "
                              "(read-only, no report-root write -- for a caller that wants render's "
                              "own characterization data without a full README render + commit)")
    add_test_point_args(ch)
    ch.add_argument("--db", default=DEFAULT_STORE_DB,
                     help="normalized wspy-store database (default: %(default)s)")
    ch.add_argument("--wspy-archetype-bin", default=os.path.join(SCRIPT_DIR, "wspy-archetype"),
                     help="wspy-archetype binary (default: %(default)s)")
    ch.set_defaults(func=cmd_characterize)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""
wspy-phoronix-import -- openbenchmarking.org-seeded single-test-point
Phoronix suites (INVESTIGATION.md item 26's front-end phase).

Decomposes an already-published Phoronix result or suite into one minimal
single-test-point PTS suite per (test, option-combination) -- growing
workload/phoronix/ into a pre-profiled workload library cheaply, instead of
hand-authoring one wspy-run invocation per benchmark. Several source methods,
mutually exclusive:

  --result <url-or-id>    an openbenchmarking.org result, e.g.
                           https://openbenchmarking.org/result/2607160-PTS-7700X3D886
                           or the bare ID. Tries a direct "Download Suite"-style
                           fetch first, falls back to the locally-installed
                           phoronix-test-suite client's own network path.
  --file <path.xml>       an XML file already on disk -- either a suite
                           export (small, <Execute> elements) or a raw
                           composite/result file (<Result> elements); both
                           shapes are detected automatically.
  --installed-suite <name>  an already-installed PTS suite, e.g.
                           "pts/compression-1.1.4" or "local/my-suite" (bare
                           names are searched under both prefixes).
  --from-installed <test_id>  an installed/downloaded test profile with no
                           prior run/import round-trip at all -- the other
                           three methods all require *evidence a specific
                           option combination already ran* (a suite-
                           definition.xml, a composite.xml, or an installed
                           suite built from one of those); this instead
                           reads test-definition.xml's own <Menu><Entry>
                           axes directly (INVESTIGATION.md's "Installed-
                           test-profile materialization deep-dive"), so it
                           works before ever running the test through PTS.
                           A zero-axis test (e.g. coremark) materializes
                           directly with no --option needed; a single-axis
                           test additionally accepts --all-single-axis to
                           materialize every entry in one call; a
                           multi-axis test needs one --option
                           <identifier>=<entry-name> per axis -- see
                           --list-options first. Deliberately no flag that
                           expands a whole multi-axis matrix in one call:
                           a naive cross product blows up fast (e.g.
                           llama.cpp's Backend x Model x Test axes multiply
                           to 160 combinations on a real host) and the
                           discipline of picking only the tuples actually
                           wanted belongs to the tool, not to hoping nobody
                           passes an --all-axes flag if one existed.
  --list-installed         list installed suites under
                           ~/.phoronix-test-suite/test-suites/{pts,local}
                           and exit -- no source needed.
  --list-materialized      list already-materialized test points under
                           --dest (default workload/phoronix/) and exit --
                           no source needed. Same inventory the web
                           launcher's Phoronix tab shows.
  --list-options <test_id>  list an installed/downloaded test's option
                           axes and entries (with GPU/backend-axis and
                           "looks buildable against files actually on
                           this host" hints, both best-effort advisory
                           badges, never a filter) and exit -- no
                           materialization, use before --from-installed
                           to see valid --option values.
  --unregister <dir-or-identity>  remove a materialized test point --
                           either its directory (as --list-materialized
                           --json's "dir" field gives) or its bare
                           identity string ("<test>-<options>", as
                           --list-materialized's own TEST/OPTIONS columns
                           combine). Only removes the registration
                           (suite-definition.xml/source.json/the runs/
                           symlinks, any test-suites/local/ copy, and the
                           wspy-ledger backlog line unless --no-ledger) --
                           real run data a runs/ symlink points at is
                           never touched, so this is safe even for a
                           point with recorded runs. For a point that's
                           never actually going to run (no Steam account
                           for a game test, a benchmark this host can't
                           build, ...).
  --from-url <url-or-file-or-->  a published Phoronix article's own
                           chart-result URL(s) -- right-click "open in
                           new tab" on any chart in an article, e.g.
                           https://www.phoronix.com/benchmark/result/
                           <article-slug>/<chart-slug>.svgz -- repeatable,
                           or a file with one URL per line, or "-" for
                           stdin. The article page itself is not fetchable
                           server-side (Cloudflare blocks it, same as
                           openbenchmarking.org), so each URL's own slug is
                           matched against locally known test profiles'
                           titles, then per axis independently against
                           that test's real option entries -- never the
                           full cross product, and never a guess: an axis
                           with no confident match is reported, not
                           picked, for a human to finish by hand with
                           --option. Only a fully-resolved URL
                           materializes automatically. See
                           web/joblib.py's resolve_phoronix_chart_url()
                           for the full design and its real, confirmed-live
                           limits (chart slugs sometimes abbreviate words
                           differently than a test's own Menu Entry text).

All the actual parsing/materialization/wspy-ledger-integration logic lives
in web/joblib.py (import_phoronix_test_points() and friends), shared with
web/server.py's Phoronix tab -- this script is a thin CLI wrapper, same
"thin client, no duplicated logic" convention as wspy-bundle/wspy-queue/
wspy-sweep.

Also writes one README.md per bare test name (workload/phoronix/<test>/README.md,
above the per-option-combination subdirectories) with the test's Description and a few
other high-level fields from `phoronix-test-suite info <test>`, unless
--no-check-installed skipped that lookup or a README already exists there
(pre-existing READMEs are left untouched, same idempotent convention as the
suite-definition.xml files).

Deliberately stops at materializing suite files and registering them with
`wspy-ledger --add` -- it does not copy anything into
~/.phoronix-test-suite/test-suites/local/, does not run anything, and does
not install anything. A materialized test point's "installed" column
(phoronix-test-suite's own "Test Installed" field) tells a human which
points still need `phoronix-test-suite install <test>` run by hand -- that
"runner script" phase is separately-scoped future work.

    wspy-phoronix-import --result https://openbenchmarking.org/result/2607160-PTS-7700X3D886
    wspy-phoronix-import --file ~/Downloads/result-suite.xml --dry-run
    wspy-phoronix-import --installed-suite pts/compression-1.1.4 --no-ledger
    wspy-phoronix-import --list-installed
"""
import argparse
import json
import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(SCRIPT_DIR, "web"))
import joblib  # noqa: E402 -- reuses import_phoronix_test_points() and friends

DEFAULT_DEST = "workload/phoronix"


def resolve_source(args):
    """Returns {"xml": bytes, "source_kind": str, "source_ref": str} or
    {"error": str}, one branch per --result/--file/--installed-suite."""
    if args.result:
        return joblib.fetch_openbenchmarking_suite_xml(args.result, phoronix_bin=args.phoronix_bin)
    if args.file:
        if not os.path.isfile(args.file):
            return {"error": f"no such file: {args.file}"}
        with open(args.file, "rb") as f:
            return {"xml": f.read(), "source_kind": "file", "source_ref": os.path.abspath(args.file)}
    path, matched_name = joblib.resolve_installed_phoronix_suite(args.installed_suite)
    if not path:
        return {"error": f"no installed suite matching {args.installed_suite!r} under "
                          f"{os.path.join(joblib.phoronix_user_data_dir(), 'test-suites')}/"
                          "{pts,local} -- see --list-installed"}
    with open(path, "rb") as f:
        return {"xml": f.read(), "source_kind": "installed-suite", "source_ref": matched_name}


def print_table(points):
    if not points:
        print("wspy-phoronix-import: no test points", file=sys.stderr)
        return
    installed_col = {True: "yes", False: "no", None: "?"}
    rows = [("TEST", "OPTIONS", "INSTALLED", "STATUS", "LEDGER")]
    for p in points:
        ledger = p.get("ledger")
        ledger_text = "-" if ledger is None else (
            "ok" if ledger.get("exit_code") == 0 else f"FAIL({ledger.get('exit_code')})")
        rows.append((p["bare_name"], p["options_slug"], installed_col.get(p.get("installed"), "?"),
                     p["status"], ledger_text))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for i, row in enumerate(rows):
        line = "  ".join(cell.ljust(widths[j]) for j, cell in enumerate(row))
        print(line)
        if i == 0:
            print("  ".join("-" * w for w in widths))


def print_inventory_table(points):
    if not points:
        print("wspy-phoronix-import: no materialized test points", file=sys.stderr)
        return
    installed_col = {True: "yes", False: "no", None: "?"}
    rows = [("TEST", "OPTIONS", "INSTALLED", "RUNS")]
    for p in points:
        runs_text = str(len(p["runs"])) if p["runs"] else "-"
        rows.append((p["bare_name"], p["options_slug"], installed_col.get(p.get("installed"), "?"), runs_text))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for i, row in enumerate(rows):
        line = "  ".join(cell.ljust(widths[j]) for j, cell in enumerate(row))
        print(line)
        if i == 0:
            print("  ".join("-" * w for w in widths))


def print_options_table(test_id, axes):
    if not axes:
        print(f"wspy-phoronix-import: {test_id} has no option axes -- a single implicit point, "
              "materialize with --from-installed and no --option", file=sys.stderr)
        return
    installed_basenames = joblib.phoronix_installed_test_file_basenames(test_id)
    buildable_col = {True: "yes", False: "no", None: "?"}
    for axis in axes:
        gpu_badge = " [GPU/backend axis]" if joblib.phoronix_axis_is_gpu_flagged(axis) else ""
        print(f"{axis['identifier']} -- {axis['display_name']}{gpu_badge}")
        rows = [("NAME", "VALUE", "BUILDABLE?")]
        for name, value in axis["entries"]:
            buildable = joblib.phoronix_entry_looks_buildable(value, installed_basenames)
            rows.append((name, value, buildable_col.get(buildable, "?")))
        widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
        for i, row in enumerate(rows):
            print("  " + "  ".join(cell.ljust(widths[j]) for j, cell in enumerate(row)))
            if i == 0:
                print("  " + "  ".join("-" * w for w in widths))
        print()


def build_installed_choice_sets(args, axes):
    """Returns (choice_sets, error_or_None) for --from-installed, from --option/--all-single-axis --
    exactly one of the three deep-dive cases (zero axes, --all-single-axis, explicit --option per
    axis), never a silent fallback between them."""
    if not axes:
        if args.option or args.all_single_axis:
            return None, "this test has no option axes -- drop --option/--all-single-axis"
        return [{}], None
    if args.all_single_axis:
        if len(axes) != 1:
            return None, f"--all-single-axis needs exactly one option axis, this test has {len(axes)}"
        if args.option:
            return None, "--all-single-axis and --option are mutually exclusive"
        identifier = axes[0]["identifier"]
        return [{identifier: name} for name, _value in axes[0]["entries"]], None
    if not args.option:
        return None, (f"this test has {len(axes)} option axis(es) -- pass --option "
                       "<identifier>=<entry-name> once per axis (see --list-options), or "
                       "--all-single-axis if it has exactly one")
    choices = {}
    for opt in args.option:
        if "=" not in opt:
            return None, f"malformed --option {opt!r} (want IDENTIFIER=ENTRY-NAME)"
        identifier, entry_name = opt.split("=", 1)
        choices[identifier] = entry_name
    axis_identifiers = {a["identifier"] for a in axes}
    missing = axis_identifiers - set(choices)
    extra = set(choices) - axis_identifiers
    if missing:
        return None, f"missing --option for axis(es): {', '.join(sorted(missing))}"
    if extra:
        return None, f"--option given for unknown axis(es): {', '.join(sorted(extra))}"
    return [choices], None


def expand_from_url_args(values):
    """Expands --from-url's raw argv values into a flat, order-preserving, deduped list of URLs --
    each value is either a literal URL, the path to a file with one URL per line ('#' comments and
    blank lines ignored, same convention ledger.c's --unavailable-deps files use), or "-" for stdin.
    Covers both ways a human pasting chart URLs actually wants to work: a few inline
    `--from-url <url>` flags, or a whole pasted/saved batch in one go -- without needing two separate
    flags whose combination argparse's mutually-exclusive --source group would have to special-case."""
    urls = []
    for value in values:
        if value == "-":
            lines = sys.stdin.read().splitlines()
        elif os.path.isfile(value):
            with open(value) as f:
                lines = f.read().splitlines()
        else:
            lines = [value]
        for line in lines:
            line = line.strip()
            if line and not line.startswith("#"):
                urls.append(line)
    seen = set()
    return [u for u in urls if not (u in seen or seen.add(u))]


def print_url_resolution_report(reports):
    """Prints one line per URL that resolve_phoronix_chart_url() couldn't fully resolve to a
    materializable point -- unrecognized/unresolved get their raw hint text so a human can act on it
    by hand; a "resolved" entry with unresolved_axes still set shows what *did* match plus which
    axes still need an explicit --option, so a human finishing it by hand isn't starting from
    nothing."""
    for r in reports:
        if r["status"] == "unrecognized-url":
            print(f"  {r['url']}: not a recognized Phoronix chart-result URL", file=sys.stderr)
        elif r["status"] == "unresolved":
            test_id_bit = f" (matched {r['test_id']}, but " + r.get("error", "axes unavailable") + ")" \
                if r.get("test_id") else ""
            print(f"  {r['url']}: no local test profile matches {r['chart_slug']!r}{test_id_bit} -- "
                  f"install/download the real test, then retry", file=sys.stderr)
        else:  # "resolved" with leftover unresolved_axes
            known = ", ".join(f"{k}={v!r}" for k, v in r["choices"].items()) or "(none)"
            print(f"  {r['url']}: matched {r['test_id']} -- resolved {known}; still need --option for "
                  f"axis(es) {', '.join(r['unresolved_axes'])} (see --list-options {r['test_id']})",
                  file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(
        description="Decompose a Phoronix result/suite into one minimal single-test-point "
                    "suite per option combination, materialized under workload/phoronix/ and "
                    "registered with wspy-ledger --add.",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--result", metavar="URL-OR-ID", help="an openbenchmarking.org result URL or bare ID")
    src.add_argument("--file", metavar="PATH", help="a suite or result/composite XML file already on disk")
    src.add_argument("--installed-suite", metavar="NAME",
                      help="an installed PTS suite, e.g. pts/compression-1.1.4 or a bare name")
    src.add_argument("--list-installed", action="store_true",
                      help="list installed suites under ~/.phoronix-test-suite/test-suites and exit")
    src.add_argument("--list-materialized", action="store_true",
                      help="list already-materialized test points under --dest and exit")
    src.add_argument("--from-installed", metavar="TEST_ID",
                      help="an installed/downloaded test profile with no prior run/import, e.g. "
                           "pts/llama-cpp-2.5.0 -- combine with --option (one per axis) or "
                           "--all-single-axis; see --list-options first to see what's available")
    src.add_argument("--list-options", metavar="TEST_ID",
                      help="list TEST_ID's option axes/entries (with GPU/backend and 'looks "
                           "buildable' hints) and exit -- no source needed, use before --from-installed")
    src.add_argument("--unregister", metavar="DIR-OR-IDENTITY",
                      help="remove a materialized test point (its directory, or its bare "
                           "'<test>-<options>' identity string) -- only the registration, real run "
                           "data is untouched; safe even with recorded runs")
    src.add_argument("--from-url", action="append", default=[], metavar="URL-OR-FILE-OR--",
                      help="a Phoronix article chart-result URL (repeatable), a file with one URL "
                           "per line, or '-' for stdin -- resolves each against locally known test "
                           "profiles and materializes whatever fully resolves; see the module "
                           "docstring for the per-axis matching design and its real limits")
    ap.add_argument("--option", action="append", default=[], metavar="IDENTIFIER=ENTRY-NAME",
                     help="one axis choice for --from-installed (repeatable, one per axis); "
                          "ENTRY-NAME must match --list-options' NAME column exactly, not its VALUE")
    ap.add_argument("--all-single-axis", action="store_true",
                     help="with --from-installed on a test that has exactly one option axis, "
                          "materialize every entry on that axis as its own point instead of "
                          "requiring --option -- deliberately no equivalent for two-or-more axes, "
                          "see the module docstring")
    ap.add_argument("--dest", default=DEFAULT_DEST,
                     help=f"destination root for materialized suites (default: {DEFAULT_DEST})")
    ap.add_argument("--ledger-list", default=None,
                     help="wspy-ledger --list path (default: <dest>/backlog.txt, wspy-ledger's own default)")
    ap.add_argument("--no-ledger", action="store_true", help="don't call wspy-ledger --add")
    ap.add_argument("--no-check-installed", action="store_true",
                     help="skip the per-test 'phoronix-test-suite info' installed check (faster "
                          "for a large result, but the INSTALLED column reports '?')")
    ap.add_argument("--dry-run", action="store_true",
                     help="show what would be materialized without writing files or calling wspy-ledger")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    ap.add_argument("--phoronix-bin", default="phoronix-test-suite")
    ap.add_argument("--ledger-bin", default=os.path.join(SCRIPT_DIR, "wspy-ledger"))
    args = ap.parse_args()

    if args.list_installed:
        names = joblib.list_installed_phoronix_suites()
        if args.json:
            print(json.dumps(names, indent=2))
        else:
            for name in names:
                print(name)
            if not names:
                print("wspy-phoronix-import: no installed suites found", file=sys.stderr)
        return 0

    if args.list_materialized:
        points = joblib.list_materialized_phoronix_test_points(args.dest)
        if args.json:
            print(json.dumps(points, indent=2))
        else:
            print_inventory_table(points)
        return 0

    if args.list_options:
        axes, error = joblib.phoronix_test_axes_for_test_id(args.list_options)
        if error:
            print(f"wspy-phoronix-import: {error}", file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(axes, indent=2))
        else:
            print_options_table(args.list_options, axes)
        return 0

    if args.unregister:
        ref = args.unregister
        test_point_dir = ref if os.path.isdir(ref) else None
        if test_point_dir is None:
            entry = joblib.find_materialized_phoronix_test_point(args.dest, ref)
            test_point_dir = entry["dir"] if entry else None
        if not test_point_dir:
            print(f"wspy-phoronix-import: no materialized test point matches {ref!r} as a directory "
                  f"or an identity under {args.dest!r}", file=sys.stderr)
            return 2
        result = joblib.unregister_phoronix_test_point(
            args.dest, test_point_dir, ledger_bin=args.ledger_bin, ledger_list_path=args.ledger_list,
            remove_from_ledger=not args.no_ledger)
        if result is None:
            print(f"wspy-phoronix-import: {test_point_dir!r} is not a materialized test point directory",
                  file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(result, indent=2))
        else:
            print(f"wspy-phoronix-import: unregistered {result['identity']}", file=sys.stderr)
            if result["local_suite_removed"]:
                print("wspy-phoronix-import: also removed its test-suites/local/ copy", file=sys.stderr)
            if result["ledger"] and result["ledger"]["exit_code"] != 0:
                print(f"wspy-phoronix-import: warning: wspy-ledger --remove failed "
                      f"(exit {result['ledger']['exit_code']}): {result['ledger']['output']}", file=sys.stderr)
        return 0

    if args.from_url:
        urls = expand_from_url_args(args.from_url)
        if not urls:
            print("wspy-phoronix-import: --from-url gave no URLs to resolve", file=sys.stderr)
            return 2

        # Group by test_id first -- several chart URLs from the same article commonly resolve to the
        # same test (e.g. 12 FIO configurations), and import_phoronix_installed_points() already
        # batches a whole test's points into one README/ledger-list pass rather than repeating it
        # once per point.
        resolved_by_test = {}
        leftover_reports = []
        for url in urls:
            result = joblib.resolve_phoronix_chart_url(url)
            if result["status"] == "resolved" and not result["unresolved_axes"]:
                resolved_by_test.setdefault(result["test_id"], []).append(result["choices"])
            else:
                leftover_reports.append(result)

        all_points, all_readmes = [], []
        for test_id, choice_sets in resolved_by_test.items():
            result = joblib.import_phoronix_installed_points(
                test_id, choice_sets, args.dest, phoronix_bin=args.phoronix_bin, ledger_bin=args.ledger_bin,
                ledger_list_path=args.ledger_list, dry_run=args.dry_run,
                check_installed=not args.no_check_installed, add_to_ledger=not args.no_ledger)
            if result["error"]:
                leftover_reports.append({"status": "unresolved", "url": f"(test {test_id})",
                                          "chart_slug": test_id, "test_id": test_id, "error": result["error"]})
                continue
            all_points.extend(result["points"])
            if result.get("readme"):
                all_readmes.append(result["readme"])

        if args.json:
            print(json.dumps({"points": all_points, "readmes": all_readmes, "unresolved": leftover_reports},
                              indent=2))
        else:
            mode = "would materialize" if args.dry_run else "materialized"
            print(f"wspy-phoronix-import: {mode} {len(all_points)} test point(s) from "
                  f"{len(urls)} pasted URL(s) ({len(resolved_by_test)} distinct test(s))", file=sys.stderr)
            if all_points:
                print_table(all_points)
            if leftover_reports:
                print(f"wspy-phoronix-import: {len(leftover_reports)} URL(s) not fully resolved:",
                      file=sys.stderr)
                print_url_resolution_report(leftover_reports)
        return 0

    if args.from_installed:
        test_id = args.from_installed
        axes, error = joblib.phoronix_test_axes_for_test_id(test_id)
        if error:
            print(f"wspy-phoronix-import: {error}", file=sys.stderr)
            return 2
        choice_sets, error = build_installed_choice_sets(args, axes)
        if error:
            print(f"wspy-phoronix-import: {error}", file=sys.stderr)
            return 2
        source = {"source_kind": "installed-test-profile", "source_ref": f"installed:{test_id}"}
        result = joblib.import_phoronix_installed_points(
            test_id, choice_sets, args.dest, phoronix_bin=args.phoronix_bin, ledger_bin=args.ledger_bin,
            ledger_list_path=args.ledger_list, dry_run=args.dry_run,
            check_installed=not args.no_check_installed, add_to_ledger=not args.no_ledger)
        result["readmes"] = [result["readme"]] if result.get("readme") else []
    else:
        source = resolve_source(args)
        if "error" in source:
            print(f"wspy-phoronix-import: {source['error']}", file=sys.stderr)
            return 2

        result = joblib.import_phoronix_test_points(
            source["xml"], args.dest, source["source_kind"], source["source_ref"],
            phoronix_bin=args.phoronix_bin, ledger_bin=args.ledger_bin,
            ledger_list_path=args.ledger_list, dry_run=args.dry_run,
            check_installed=not args.no_check_installed, add_to_ledger=not args.no_ledger)

    if result["error"]:
        print(f"wspy-phoronix-import: {result['error']}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps(result, indent=2))
    else:
        mode = "would materialize" if args.dry_run else "materialized"
        print(f"wspy-phoronix-import: {mode} {len(result['points'])} test point(s) from "
              f"{source['source_kind']} ({source['source_ref']}) into {args.dest}/", file=sys.stderr)
        print_table(result["points"])
        readmes = result.get("readmes", [])
        written = [r for r in readmes if r["status"] in ("created", "would-create")]
        if written:
            verb = "would write" if args.dry_run else "wrote"
            print(f"wspy-phoronix-import: {verb} {len(written)} README.md ({', '.join(r['bare_name'] for r in written)})",
                  file=sys.stderr)
        skipped = [r for r in readmes if r["status"] == "skipped"]
        if skipped:
            print(f"wspy-phoronix-import: no README for {len(skipped)} test(s) "
                  f"(--no-check-installed or `phoronix-test-suite info` failed)", file=sys.stderr)
        failed_ledger = [p for p in result["points"]
                          if p.get("ledger") and p["ledger"].get("exit_code") != 0]
        if failed_ledger:
            print(f"wspy-phoronix-import: warning: wspy-ledger --add failed for "
                  f"{len(failed_ledger)} point(s)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
